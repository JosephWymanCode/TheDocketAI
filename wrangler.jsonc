{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docket-subscribe",
  "compatibility_date": "2026-06-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rate_limiting": [
    {
      "name": "RATE_LIMITER",
      "threshold": 10,
      "period": 60,
      "action": "log"
    }
  ]
}
